{
  "contract": "crosscorpus-storage/v1",
  "note": "Reference cases for the decision functions each repository implements itself (CONTRACT section 12). Every expected value is written by hand from the contract text; none is the output of an implementation. Paths are abstract: they name no machine. 'role_separation' expects the sorted list of distinct codes. 'namespace' gives and expects path segments. The other functions expect one state or one object.",
  "role_separation": [
    {"id": "siblings-under-one-umbrella", "roots": {"REPO": "/u/corapan", "RUNTIME": "/u/corapan_workspace", "SPOOL": "/u/corapan_storage", "PRESERVATION": "/fs/projects/panhispanic_media_corpora/corapan"}, "expect": [], "why": "5.2: sibling roots under one umbrella are the intended layout; the umbrella is no role"},
    {"id": "name-prefix-is-not-nesting", "roots": {"REPO": "/u/corapan", "SPOOL": "/u/corapan_storage"}, "expect": [], "why": "5.1: segments are compared, not characters: corapan_storage is not inside corapan"},
    {"id": "two-roles-one-root", "roots": {"RUNTIME": "/u/work", "SPOOL": "/u/work"}, "expect": ["ROLE_SHARED"], "why": "S1"},
    {"id": "same-root-other-spelling", "roots": {"RUNTIME": "/U/Work/", "SPOOL": "\\u\\work"}, "expect": ["ROLE_SHARED"], "why": "5.1: separators, a trailing separator and letter case carry nothing"},
    {"id": "spool-inside-runtime", "roots": {"RUNTIME": "/u/work", "SPOOL": "/u/work/spool"}, "expect": ["ROLE_NESTED"], "why": "S2"},
    {"id": "runtime-inside-checkout", "roots": {"REPO": "/u/corapan", "RUNTIME": "/u/corapan/workspace"}, "expect": ["ROLE_NESTED"], "why": "S2: the checkout takes part"},
    {"id": "declared-co-location", "roots": {"REPO": "/u/corapan", "RUNTIME": "/u/corapan"}, "co_located": [["REPO", "RUNTIME"]], "expect": [], "why": "5.1: a declared co-location is exempt for exactly that pair"},
    {"id": "co-location-covers-only-its-pair", "roots": {"REPO": "/u/corapan", "RUNTIME": "/u/corapan", "SPOOL": "/u/corapan/spool"}, "co_located": [["REPO", "RUNTIME"]], "expect": ["ROLE_NESTED"], "why": "5.1: the spool is not part of the declared pair"},
    {"id": "preservation-is-never-co-located", "roots": {"RUNTIME": "/fs/p", "PRESERVATION": "/fs/p"}, "co_located": [["RUNTIME", "PRESERVATION"]], "expect": ["ROLE_SHARED"], "why": "5.1: PRESERVATION, BACKUP and SPOOL are never part of a co-location"},
    {"id": "backup-on-another-volume", "roots": {"PRESERVATION": "/fs/p/corapan", "BACKUP": "/d/p/corapan/backup"}, "volumes": {"PRESERVATION": "vol-fs", "BACKUP": "vol-d"}, "expect": [], "why": "S3"},
    {"id": "backup-on-the-primarys-volume", "roots": {"PRESERVATION": "/d/p/coprepan/preservation_interim", "BACKUP": "/d/p/coprepan/backup"}, "volumes": {"PRESERVATION": "vol-d", "BACKUP": "vol-d"}, "expect": ["BACKUP_NOT_INDEPENDENT"], "why": "S3, B2: two directories of one volume are one copy"},
    {"id": "backup-volume-unknown", "roots": {"PRESERVATION": "/fs/p/corapan", "BACKUP": "/d/p/corapan/backup"}, "volumes": {"PRESERVATION": "vol-fs", "BACKUP": null}, "expect": ["VOLUME_UNKNOWN"], "why": "S3: an unknown volume is a refusal, never a guess"},
    {"id": "no-volume-information-at-all", "roots": {"PRESERVATION": "/fs/p/corapan", "BACKUP": "/d/p/corapan/backup"}, "expect": ["VOLUME_UNKNOWN"], "why": "S3"},
    {"id": "backup-inside-the-primary", "roots": {"PRESERVATION": "/d/p/x", "BACKUP": "/d/p/x/backup"}, "volumes": {"PRESERVATION": "vol-d", "BACKUP": "vol-d"}, "expect": ["BACKUP_NOT_INDEPENDENT", "ROLE_NESTED"], "why": "S2 and S3 are both reported"},
    {"id": "volume-rule-needs-both-roles", "roots": {"PRESERVATION": "/fs/p/corapan", "RUNTIME": "/u/w"}, "expect": [], "why": "S3 applies only when BACKUP is configured"},
    {"id": "under-the-other-corpus", "roots": {"PRESERVATION": "/k/Corapan/coprepan"}, "foreign_roots": ["/k/Corapan"], "expect": ["FOREIGN_CORPUS_OVERLAP"], "why": "S4: one corpus's storage is never placed under the other's root"},
    {"id": "the-other-corpus-under-this-one", "roots": {"SPOOL": "/u/storage"}, "foreign_roots": ["/u/storage/corapan"], "expect": ["FOREIGN_CORPUS_OVERLAP"], "why": "S4: contains"},
    {"id": "same-root-as-the-other-corpus", "roots": {"SPOOL": "/u/storage"}, "foreign_roots": ["/U/Storage"], "expect": ["FOREIGN_CORPUS_OVERLAP"], "why": "S4: equals, case-insensitively"},
    {"id": "sister-corpora-side-by-side", "roots": {"PRESERVATION": "/fs/projects/panhispanic_media_corpora/coprepan", "SPOOL": "/u/coprepan_storage"}, "foreign_roots": ["/fs/projects/panhispanic_media_corpora/corapan", "/u/corapan_storage", "/u/corapan"], "expect": [], "why": "5.2: the institutional namespace and the local umbrella hold both corpora as siblings"},
    {"id": "several-defects-at-once", "roots": {"RUNTIME": "/u/w", "SPOOL": "/u/w", "DISTRIBUTION": "/u/w/out"}, "expect": ["ROLE_NESTED", "ROLE_SHARED"], "why": "every defect is reported once"}
  ],
  "namespace": [
    {"id": "bare-volume", "provided_root": ["D:"], "corpus": "corapan", "holding": "PRODUCTION", "expect": ["D:", "projects", "panhispanic_media_corpora", "corapan"]},
    {"id": "root-already-ends-in-projects", "provided_root": ["D:", "projects"], "corpus": "coprepan", "holding": "PRODUCTION", "expect": ["D:", "projects", "panhispanic_media_corpora", "coprepan"], "why": "5.2: no projects/projects"},
    {"id": "root-already-ends-in-the-project-namespace", "provided_root": ["mnt", "fs", "projects", "panhispanic_media_corpora"], "corpus": "corapan", "holding": "PRODUCTION", "expect": ["mnt", "fs", "projects", "panhispanic_media_corpora", "corapan"]},
    {"id": "case-insensitive-overlap-keeps-the-provided-spelling", "provided_root": ["mnt", "fs", "Projects"], "corpus": "corapan", "holding": "PRODUCTION", "expect": ["mnt", "fs", "Projects", "panhispanic_media_corpora", "corapan"]},
    {"id": "projects-not-at-the-end-is-not-an-overlap", "provided_root": ["mnt", "projects", "share7"], "corpus": "coprepan", "holding": "PRODUCTION", "expect": ["mnt", "projects", "share7", "projects", "panhispanic_media_corpora", "coprepan"], "why": "5.2: only leading namespace segments that the root ENDS with are not repeated"},
    {"id": "historic-holding", "provided_root": ["D:"], "corpus": "corapan", "holding": "HISTORIC", "expect": ["D:", "projects", "panhispanic_media_corpora", "historic", "corapan"]},
    {"id": "historic-holding-root-in-the-namespace", "provided_root": ["mnt", "fs", "projects", "panhispanic_media_corpora"], "corpus": "coprepan", "holding": "HISTORIC", "expect": ["mnt", "fs", "projects", "panhispanic_media_corpora", "historic", "coprepan"]},
    {"id": "root-is-already-the-corpus-root", "provided_root": ["mnt", "fs", "projects", "panhispanic_media_corpora", "corapan"], "corpus": "corapan", "holding": "PRODUCTION", "expect": ["mnt", "fs", "projects", "panhispanic_media_corpora", "corapan"]}
  ],
  "configuration_state": [
    {"id": "not-declared", "declared": false, "value": null, "default": null, "usable": false, "reachable": false, "writable": false, "need_write": true, "expect": "NOT_DECLARED"},
    {"id": "unset", "declared": true, "value": null, "default": null, "usable": false, "reachable": false, "writable": false, "need_write": true, "expect": "NOT_CONFIGURED"},
    {"id": "empty-is-unset", "declared": true, "value": "", "default": null, "usable": false, "reachable": false, "writable": false, "need_write": true, "expect": "NOT_CONFIGURED"},
    {"id": "blank-is-unset", "declared": true, "value": "   ", "default": null, "usable": false, "reachable": false, "writable": false, "need_write": true, "expect": "NOT_CONFIGURED"},
    {"id": "unset-with-a-tracked-default", "declared": true, "value": null, "default": "repo", "usable": true, "reachable": true, "writable": true, "need_write": true, "expect": "DEFAULTED"},
    {"id": "set-but-unreachable-never-defaults", "declared": true, "value": "/fs/x", "default": "repo", "usable": true, "reachable": false, "writable": false, "need_write": true, "expect": "UNREACHABLE", "why": "I1: a set value that cannot be used is a refusal, not a reason to default"},
    {"id": "set-but-unusable", "declared": true, "value": "relative/path", "default": null, "usable": false, "reachable": false, "writable": false, "need_write": false, "expect": "UNUSABLE"},
    {"id": "unusable-before-unreachable", "declared": true, "value": "/", "default": null, "usable": false, "reachable": true, "writable": true, "need_write": false, "expect": "UNUSABLE"},
    {"id": "reachable-read-only-write-needed", "declared": true, "value": "/fs/x", "default": null, "usable": true, "reachable": true, "writable": false, "need_write": true, "expect": "READ_ONLY"},
    {"id": "reachable-read-only-read-is-enough", "declared": true, "value": "/fs/x", "default": null, "usable": true, "reachable": true, "writable": false, "need_write": false, "expect": "AVAILABLE"},
    {"id": "available", "declared": true, "value": "/fs/x", "default": null, "usable": true, "reachable": true, "writable": true, "need_write": true, "expect": "AVAILABLE"}
  ],
  "preservation_outcome": [
    {"id": "verified-on-the-primary-with-its-record", "content_ok": true, "primary": "AVAILABLE", "primary_copy_verified": true, "record_written": true, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": false,
     "expect": {"state": "PRESERVED", "pending_location": null, "spool_copy_releasable": true, "local_copy_protected": false}, "why": "P2, P7"},
    {"id": "written-but-not-re-read", "content_ok": true, "primary": "AVAILABLE", "primary_copy_verified": false, "record_written": true, "spool": "NOT_CONFIGURED", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P2: no success without verification of the bytes on the primary"},
    {"id": "verified-but-no-record", "content_ok": true, "primary": "AVAILABLE", "primary_copy_verified": true, "record_written": false, "spool": "NOT_CONFIGURED", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P2: the persistent record is part of success"},
    {"id": "primary-unreachable-spooled", "content_ok": true, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": true,
     "expect": {"state": "PENDING", "pending_location": "SPOOL", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P1, P5"},
    {"id": "primary-not-configured-spooled", "content_ok": true, "primary": "NOT_CONFIGURED", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": true,
     "expect": {"state": "PENDING", "pending_location": "SPOOL", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P1"},
    {"id": "primary-unreachable-no-spool", "content_ok": true, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "NOT_CONFIGURED", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P5: the object stays where it is, still pending"},
    {"id": "primary-unreachable-spool-configured-but-unreachable", "content_ok": true, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "UNREACHABLE", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P5: a configured but unreachable spool deletes nothing and marks nothing as done"},
    {"id": "primary-unreachable-spool-full", "content_ok": true, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P5: the spool is bounded"},
    {"id": "primary-unreachable-spool-copy-not-verified", "content_ok": true, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": false,
     "expect": {"state": "PENDING", "pending_location": "WORKSPACE", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P5: only a verified copy counts as the spool's copy"},
    {"id": "primary-read-only", "content_ok": true, "primary": "READ_ONLY", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": true,
     "expect": {"state": "PENDING", "pending_location": "SPOOL", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P1"},
    {"id": "content-refused-is-never-spooled", "content_ok": false, "primary": "UNREACHABLE", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": false,
     "expect": {"state": "REFUSED", "pending_location": null, "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P6"},
    {"id": "content-refused-with-the-primary-available", "content_ok": false, "primary": "AVAILABLE", "primary_copy_verified": false, "record_written": false, "spool": "NOT_CONFIGURED", "spool_has_capacity": false, "spool_copy_verified": false,
     "expect": {"state": "REFUSED", "pending_location": null, "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P6: a refused object is evidence; nothing removes it"},
    {"id": "drained-and-verified", "content_ok": true, "primary": "AVAILABLE", "primary_copy_verified": true, "record_written": true, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": true,
     "expect": {"state": "PRESERVED", "pending_location": null, "spool_copy_releasable": true, "local_copy_protected": false}, "why": "P7: the spool copy is released only after the primary verifies"},
    {"id": "drain-could-not-verify", "content_ok": true, "primary": "AVAILABLE", "primary_copy_verified": false, "record_written": false, "spool": "AVAILABLE", "spool_has_capacity": true, "spool_copy_verified": true,
     "expect": {"state": "PENDING", "pending_location": "SPOOL", "spool_copy_releasable": false, "local_copy_protected": true}, "why": "P7: a drain that cannot verify releases nothing"}
  ],
  "cleanup": [
    {"id": "pending-in-the-workspace", "pending": true, "on_primary": false, "regenerable": false, "verified_copy_on_primary": false, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R2"},
    {"id": "pending-even-if-called-a-cache", "pending": true, "on_primary": false, "regenerable": true, "verified_copy_on_primary": false, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R1, R2: a class is not a licence"},
    {"id": "pending-even-with-a-recorded-decision", "pending": true, "on_primary": false, "regenerable": false, "verified_copy_on_primary": false, "named_by_frozen_release": false, "deletion_decision_recorded": true, "expect": "PROTECTED", "why": "R2"},
    {"id": "sole-copy-in-the-workspace", "pending": false, "on_primary": false, "regenerable": false, "verified_copy_on_primary": false, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R2"},
    {"id": "unknown-is-protected", "pending": false, "on_primary": false, "regenerable": null, "verified_copy_on_primary": null, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R2: what cannot be established is treated as protected"},
    {"id": "regenerable-runtime-data", "pending": false, "on_primary": false, "regenerable": true, "verified_copy_on_primary": false, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "REMOVABLE"},
    {"id": "local-duplicate-of-a-verified-master", "pending": false, "on_primary": false, "regenerable": false, "verified_copy_on_primary": true, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "REMOVABLE", "why": "P7: the copy is no longer the only one"},
    {"id": "local-duplicate-of-a-released-object", "pending": false, "on_primary": false, "regenerable": false, "verified_copy_on_primary": true, "named_by_frozen_release": true, "deletion_decision_recorded": false, "expect": "REMOVABLE", "why": "R4 holds the object on the primary, not every duplicate of it"},
    {"id": "on-the-primary-without-a-decision", "pending": false, "on_primary": true, "regenerable": false, "verified_copy_on_primary": true, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R3"},
    {"id": "on-the-primary-regenerable-is-no-reason", "pending": false, "on_primary": true, "regenerable": true, "verified_copy_on_primary": true, "named_by_frozen_release": false, "deletion_decision_recorded": false, "expect": "PROTECTED", "why": "R1, R3"},
    {"id": "on-the-primary-with-a-recorded-decision", "pending": false, "on_primary": true, "regenerable": false, "verified_copy_on_primary": true, "named_by_frozen_release": false, "deletion_decision_recorded": true, "expect": "REMOVABLE", "why": "R3"},
    {"id": "on-the-primary-named-by-a-frozen-release", "pending": false, "on_primary": true, "regenerable": false, "verified_copy_on_primary": true, "named_by_frozen_release": true, "deletion_decision_recorded": true, "expect": "PROTECTED", "why": "R4 outranks a deletion decision while the release exists"}
  ],
  "backup_status": [
    {"id": "nothing-configured", "configured": false, "copy_exists": false, "produced_from_primary": false, "verified_against_primary": false, "primary_volume": "vol-d", "backup_volume": null, "expect": "NOT_CONFIGURED"},
    {"id": "a-class-is-not-a-backup", "configured": false, "copy_exists": false, "produced_from_primary": false, "verified_against_primary": false, "primary_volume": "vol-fs", "backup_volume": null, "protection_class_requires_backup": true, "expect": "NOT_CONFIGURED", "why": "B1, R5: a backup-required class is a statement of intent"},
    {"id": "configured-nothing-copied", "configured": true, "copy_exists": false, "produced_from_primary": false, "verified_against_primary": false, "primary_volume": "vol-fs", "backup_volume": "vol-d", "expect": "CONFIGURED_NO_COPY", "why": "B1"},
    {"id": "copied-not-verified", "configured": true, "copy_exists": true, "produced_from_primary": true, "verified_against_primary": false, "primary_volume": "vol-fs", "backup_volume": "vol-d", "expect": "COPY_UNVERIFIED", "why": "B1"},
    {"id": "a-renamed-former-primary-is-not-a-backup", "configured": true, "copy_exists": true, "produced_from_primary": false, "verified_against_primary": true, "primary_volume": "vol-fs", "backup_volume": "vol-d", "expect": "COPY_UNVERIFIED", "why": "B6: a backup is produced from the authoritative primary"},
    {"id": "same-volume", "configured": true, "copy_exists": true, "produced_from_primary": true, "verified_against_primary": true, "primary_volume": "vol-d", "backup_volume": "vol-d", "expect": "NOT_INDEPENDENT", "why": "B2"},
    {"id": "volume-of-the-backup-unknown", "configured": true, "copy_exists": true, "produced_from_primary": true, "verified_against_primary": true, "primary_volume": "vol-fs", "backup_volume": null, "expect": "INDEPENDENCE_UNKNOWN", "why": "S3, B3"},
    {"id": "volume-of-the-primary-unknown", "configured": true, "copy_exists": true, "produced_from_primary": true, "verified_against_primary": true, "primary_volume": null, "backup_volume": "vol-d", "expect": "INDEPENDENCE_UNKNOWN"},
    {"id": "verified-secondary-copy", "configured": true, "copy_exists": true, "produced_from_primary": true, "verified_against_primary": true, "primary_volume": "vol-fs", "backup_volume": "vol-d", "expect": "BACKUP_VERIFIED", "why": "B1, B2; B3: further independence is not determined"}
  ]
}
