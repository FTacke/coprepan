{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crosscorpus-release-pointer/v1",
  "title": "Release pointer (RELEASE_POINTER.json)",
  "description": "What a convenience view such as 'latest' stood for when it was generated. Mutable by replacement; never an identity (CONTRACT section 11.4).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "corpus_id", "release_id", "release_manifest_sha256", "generated_at"],
  "properties": {
    "schema": {"const": "crosscorpus-release-pointer/v1"},
    "contract": {"const": "crosscorpus-release/v1"},
    "corpus_id": {"enum": ["corapan", "coprepan"]},
    "release_id": {"type": "string", "pattern": "^(corapan|coprepan)-[a-z0-9]+([.-][a-z0-9]+)*$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"}
  }
}
