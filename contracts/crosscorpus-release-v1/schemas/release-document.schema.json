{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crosscorpus-release-document/v1",
  "title": "Release document (one line of DOCUMENTS.jsonl)",
  "description": "The sampled unit of the corpus (a recording; an article in one textual state) as a member of a release. Field names, value states and date rules are those of crosscorpus-analysis/v1 section 5.3; export_id, audio_ms and source_sha256 are added by this contract (CONTRACT section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id", "export_id", "outlet_id", "country_id",
    "date", "date_state", "date_basis", "date_basis_state", "cohort", "cohort_state",
    "tokens_counted", "tokens_counted_state", "audio_ms", "audio_ms_state", "source_sha256", "source_sha256_state"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "export_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "outlet_id": {"type": "string", "pattern": "^[a-z]{2}_[a-z0-9]+(_[a-z0-9]+)*$"},
    "country_id": {"type": "string", "pattern": "^[a-z]{2}$"},
    "date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_state": {"$ref": "#/$defs/state"},
    "date_basis": {"type": ["string", "null"]},
    "date_basis_state": {"$ref": "#/$defs/state"},
    "cohort": {"type": ["string", "null"], "pattern": "^[0-9]{4}-Q[1-4]$"},
    "cohort_state": {"$ref": "#/$defs/state"},
    "tokens_counted": {"type": ["integer", "null"], "minimum": 0},
    "tokens_counted_state": {"$ref": "#/$defs/state"},
    "audio_ms": {"type": ["integer", "null"], "minimum": 0},
    "audio_ms_state": {"$ref": "#/$defs/state"},
    "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_sha256_state": {"$ref": "#/$defs/state"}
  },
  "$defs": {
    "state": {"enum": ["known", "unknown", "not_applicable", "undecided", "not_available"]}
  }
}
