{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crosscorpus-release-manifest/v1",
  "title": "Release manifest (RELEASE_MANIFEST.json)",
  "description": "One immutable corpus state. Small by construction: members, documents and coverage are pinned record sets, not inline lists. The manifest never contains its own digest (CONTRACT section 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract", "corpus_id", "release_id", "release_kind", "fixture", "modality", "created_at",
    "previous_release", "members", "documents", "coverage", "changes", "selection_policy", "date_semantics",
    "token_denominator", "token_denominator_state", "totals", "anchors", "vocabularies", "analysis_layer", "provenance"
  ],
  "properties": {
    "schema": {"const": "crosscorpus-release-manifest/v1"},
    "contract": {"const": "crosscorpus-release/v1"},
    "corpus_id": {"enum": ["corapan", "coprepan"]},
    "release_id": {"$ref": "#/$defs/release_id"},
    "release_kind": {"enum": ["release", "provisional_export", "fixture"]},
    "fixture": {"type": "boolean"},
    "modality": {"enum": ["spoken", "written"]},
    "created_at": {"$ref": "#/$defs/instant"},
    "previous_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "release_id", "release_manifest_sha256"],
      "properties": {
        "state": {"enum": ["known", "not_applicable"]},
        "release_id": {"type": ["string", "null"], "pattern": "^(corapan|coprepan)-[a-z0-9]+([.-][a-z0-9]+)*$"},
        "release_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "members": {"$ref": "#/$defs/record_set"},
    "documents": {"$ref": "#/$defs/record_set"},
    "coverage": {"$ref": "#/$defs/record_set"},
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "replaced", "removed"],
      "properties": {
        "added": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "replaced": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["old", "new", "reason"],
            "properties": {"old": {"$ref": "#/$defs/text"}, "new": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["export_id", "reason"],
            "properties": {"export_id": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
          }
        }
      }
    },
    "selection_policy": {"$ref": "#/$defs/pin"},
    "date_semantics": {"const": "crosscorpus-date-semantics/v1"},
    "token_denominator": {"type": ["string", "null"]},
    "token_denominator_state": {"$ref": "#/$defs/state"},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exports", "documents", "tokens_counted", "tokens_counted_state", "audio_ms", "audio_ms_state"],
      "properties": {
        "exports": {"type": "integer", "minimum": 0},
        "documents": {"type": "integer", "minimum": 0},
        "tokens_counted": {"type": ["integer", "null"], "minimum": 0},
        "tokens_counted_state": {"$ref": "#/$defs/state"},
        "audio_ms": {"type": ["integer", "null"], "minimum": 0},
        "audio_ms_state": {"$ref": "#/$defs/state"}
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_kind", "unit_kinds", "producer_kinds", "source_kind", "source_included",
        "offset_reference", "offset_reference_state", "time_reference", "time_reference_state"
      ],
      "properties": {
        "document_kind": {"enum": ["recording", "document_version"]},
        "unit_kinds": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "producer_kinds": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "source_kind": {"enum": ["audio_master", "extracted_text"]},
        "source_included": {"const": false},
        "offset_reference": {"type": ["string", "null"]},
        "offset_reference_state": {"$ref": "#/$defs/state"},
        "time_reference": {"type": ["string", "null"]},
        "time_reference_state": {"$ref": "#/$defs/state"}
      }
    },
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_basis", "export_schema"],
      "properties": {
        "date_basis": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "export_schema": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schema_id"}}
      }
    },
    "analysis_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "contract", "manifest_sha256"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "contract": {"type": ["string", "null"]},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "pipeline", "stack", "models", "configuration", "member_code_commits"],
      "properties": {
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "commit", "tool", "tool_version"],
          "properties": {
            "repository": {"$ref": "#/$defs/text"},
            "commit": {"$ref": "#/$defs/commit"},
            "tool": {"$ref": "#/$defs/text"},
            "tool_version": {"$ref": "#/$defs/text"}
          }
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "versions"],
          "properties": {
            "id": {"$ref": "#/$defs/text"},
            "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
          }
        },
        "stack": {"$ref": "#/$defs/pin"},
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "id", "revision", "revision_state"],
            "properties": {
              "role": {"$ref": "#/$defs/text"},
              "id": {"$ref": "#/$defs/text"},
              "revision": {"type": ["string", "null"]},
              "revision_state": {"$ref": "#/$defs/state"}
            }
          }
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": {"id": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        },
        "member_code_commits": {"type": "array", "items": {"$ref": "#/$defs/commit"}}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "release_id": {"type": "string", "pattern": "^(corapan|coprepan)-[a-z0-9]+([.-][a-z0-9]+)*$"},
    "schema_id": {"type": "string", "pattern": "^[a-z]+-[a-z0-9]+(-[a-z0-9]+)*/v[1-9][0-9]*$"},
    "state": {"enum": ["known", "unknown", "not_applicable", "undecided", "not_available"]},
    "record_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "records", "sha256"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema_id"},
        "records": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "id", "sha256"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "id": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
