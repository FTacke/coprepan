{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crosscorpus-release-freeze/v1",
  "title": "Release freeze record (RELEASE_FREEZE.json)",
  "description": "The act that makes a manifest a release: it names the manifest by its digest. It is written after the manifest and is never part of it (CONTRACT section 9).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "corpus_id", "release_id", "release_manifest_sha256", "state", "frozen_at", "frozen_by"],
  "properties": {
    "schema": {"const": "crosscorpus-release-freeze/v1"},
    "contract": {"const": "crosscorpus-release/v1"},
    "corpus_id": {"enum": ["corapan", "coprepan"]},
    "release_id": {"type": "string", "pattern": "^(corapan|coprepan)-[a-z0-9]+([.-][a-z0-9]+)*$"},
    "release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"const": "FROZEN"},
    "frozen_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "frozen_by": {"type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
  }
}
