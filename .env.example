# COPREPAN 3.0 -- workstation environment (copy to `.env`; `.env` is gitignored).
#
# Storage roots are deliberately empty here. An unset root is a refusal, not a default:
# docs/storage/INDEX.md §5. Do not put a real path into this tracked example.
COPREPAN_WORKSPACE_ROOT=
COPREPAN_PRESERVATION_ROOT=
COPREPAN_SPOOL_ROOT=
COPREPAN_DISTRIBUTION_ROOT=
COPREPAN_EXCHANGE_ROOT=
